# Local sandbox only. Change these before exposing the stack.
DB_PASSWORD=local-database-change-me
LOCAL_PASSWORD=local-login-change-me
WEBHOOK_SECRET=local-webhook-secret-change-me-32-chars
# Optional Stripe sandbox overlay. Configure locally; never commit real keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MARKETPLACE_PUBLIC_URL=http://localhost:8097
# Production-auth overlay additionally requires:
# OIDC_ISSUER_URI=https://identity.example.com/realms/marketplace
# OIDC_CLIENT_ID=marketplace
# OIDC_CLIENT_SECRET=...
# OIDC_AUDIENCE=marketplace
# OIDC_ROLES_CLIENT=marketplace
# Optional Kafka/Shippo/Stripe Tax overlays:
# SHIPPO_TEST_TOKEN=shippo_test_...
# STRIPE_TAX_TEST_KEY=sk_test_...
