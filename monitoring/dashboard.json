{
  "title": "Marketplace sandbox",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP p99 by route",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum by(le,uri)(rate(http_server_requests_seconds_bucket[5m])))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Confirmed orders / second",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(marketplace_checkout_confirmed_total[5m])"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Workflow / refund / outbox backlog",
      "type": "timeseries",
      "targets": [
        {
          "expr": "marketplace_saga_pending"
        },
        {
          "expr": "marketplace_refund_pending"
        },
        {
          "expr": "marketplace_outbox_pending"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "DB pool pending",
      "type": "timeseries",
      "targets": [
        {
          "expr": "hikaricp_connections_pending"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
  ]
}
